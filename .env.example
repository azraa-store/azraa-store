# AZRAA frontend environment.
# Copy to `.env.local` and fill in. Only PUBLISHABLE keys belong here, they ship
# to the browser. Secret keys and all charge/capture calls live on the backend
# (azraa-backend, deployed separately).

# --- Supabase (auth, profiles, addresses) ---
# Settings -> API in the Supabase dashboard. The anon key is safe client-side,
# protected by the RLS policies in supabase/schema.sql. When unset, auth falls
# back to a localStorage mock (src/services/auth/mock.js).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Cloudflare Turnstile (bot protection on auth/enquiry/newsletter forms) ---
VITE_TURNSTILE_SITE_KEY=

# --- Cloudflare R2 (product image storage) ---
# Public base URL the bucket serves from, e.g. https://cdn.azraa.store
VITE_R2_PUBLIC_BASE_URL=

# --- Sentry (frontend error tracking) ---
VITE_SENTRY_DSN=

# --- azraa-backend base URL (payment session/verify calls, Turnstile verify) ---
VITE_API_BASE_URL=

# --- Payments (publishable keys only) ---
# India, Razorpay  https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID=

# Nigeria/Ghana/Kenya/South Africa, Paystack  https://dashboard.paystack.com/#/settings/developers
VITE_PAYSTACK_PUBLIC_KEY=

# International, PayPal  https://developer.paypal.com/dashboard/applications
VITE_PAYPAL_CLIENT_ID=

# --- Optional ---
# AZRAA Bot, customer-service assistant.
# When set, every chat turn is POSTed here and answered by the model on the
# server (the model key + system prompt stay server-side). When unset, the bot
# answers from the site's own catalogue / pricing / policy data (no network).
#   POST <endpoint>  { messages:[{role,content}], context:{...} }
#   -> { content, chips?, products?, links?, handoff? }
VITE_ASSISTANT_ENDPOINT=
