PORT=10000
# Set to the deployed frontend origin(s) once known, e.g. https://azraa.store
CORS_ORIGIN=*

# Supabase — service role key is secret, server-only, never ship it to the frontend
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile — secret key, server-only (the site key is public/frontend)
TURNSTILE_SECRET_KEY=

# Razorpay — India
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Paystack — Nigeria
PAYSTACK_SECRET_KEY=

# Flutterwave — pan-African
FLUTTERWAVE_SECRET_KEY=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
